# Copie para .env (nunca commitado — já está no .gitignore) e preencha com a connection string
# real do Neon. Use a connection string "pooled" (com "-pooler" no host, ou parâmetro
# pgbouncer=true) para a aplicação — é o que evita esgotar conexões do Postgres sob carga
# (ver DIRECT_URL abaixo para o caso em que o Prisma precisa de conexão direta).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Migrations do Prisma precisam de uma conexão DIRETA (sem pooler) — o Neon fornece as duas
# variantes de host (com e sem "-pooler"). Sem isso, "prisma migrate" pode falhar.
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

PORT=3333

# Origem(ns) do frontend liberada(s) no CORS — lista separada por vírgula. Em dev, o Vite serve
# HTTPS (vite.config.js, necessário pra testar PWA/Push num celular pela rede local — Service
# Worker exige contexto seguro) e qualquer origem https(s) de IP privado nessa porta já é liberada
# automaticamente fora de produção (ver app.ts). Em produção, incluir a origem real do GitHub
# Pages (ex.: "https://usuario.github.io") — sem protocolo/subcaminho errado, CORS é só scheme+
# host+porta.
FRONTEND_ORIGIN="https://localhost:5173,http://localhost:5173"

# Base completa (origem + subcaminho, SEM barra no final) de onde o frontend está publicado — só
# usada pra montar o link ABSOLUTO que vai dentro do payload de Web Push (clicar na notificação do
# sistema precisa abrir a aba certa mesmo com o app fechado). Em produção o GitHub Pages publica
# num subcaminho (ex.: "https://usuario.github.io/teachers-app"), não na raiz do domínio — por
# isso isto é separado de FRONTEND_ORIGIN (que é só scheme+host+porta, exigência do CORS). Sem
# configurar, o link cai pra relativo à origem (só correto se o app estiver na raiz do domínio).
FRONTEND_URL="https://localhost:5173"

# Segredo para assinar os JWT (mínimo 32 caracteres). Gere um aleatório, nunca commite o real.
JWT_SECRET="troque-por-um-segredo-aleatorio-com-48-ou-mais-caracteres"

# Chaves VAPID para Web Push (notificações). Gerar o par com: npx web-push generate-vapid-keys
# VAPID_SUBJECT é um "mailto:" ou URL de contato exigido pelo protocolo Web Push — nunca enviado
# ao navegador do usuário, só usado pelo serviço de push (FCM/Mozilla/etc.) para identificar quem
# está enviando, caso precise entrar em contato sobre abuso.
VAPID_PUBLIC_KEY="gerar-com-npx-web-push-generate-vapid-keys"
VAPID_PRIVATE_KEY="gerar-com-npx-web-push-generate-vapid-keys-nunca-commitar-a-real"
VAPID_SUBJECT="mailto:contato@seudominio.gov.br"
