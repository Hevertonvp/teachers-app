// Schema inicial — núcleo do domínio (Escola, Turma, Disciplina, Pessoa e vínculos), sem PDI
// completo ainda (Modelo/Aplicação/Ficha/Resposta ficam para uma etapa futura, quando as
// decisões de negócio pendentes — Gestor em PDI, múltiplos modelos por disciplina, etc. —
// estiverem fechadas). Ver README.md do backend para o raciocínio de cada decisão de modelagem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums ------------------------------------------------------------------------------

enum StatusRegistro {
  ATIVA
  INATIVA
}

enum StatusVinculo {
  ATIVO
  ENCERRADO
}

enum StatusPessoa {
  ATIVO
  INATIVO
}

enum StatusAluno {
  ATIVO
  ARQUIVADO
}

enum EtapaEnsino {
  FUNDAMENTAL
  EDUCACAO_INFANTIL
}

enum Turno {
  MANHA
  TARDE
}

enum SegmentoInfantil {
  CRECHE
  PRE_ESCOLA
}

// BercarioI/II e MaternalI/II pertencem ao segmento Creche; PreI/PreII a PreEscola — a
// coerência é validada na camada de serviço (ver src/domain/turma.ts), não no schema.
enum NivelInfantil {
  BERCARIO_I
  BERCARIO_II
  MATERNAL_I
  MATERNAL_II
  PRE_I
  PRE_II
}

// Perfis conhecidos hoje no frontend. Autenticação real (JWT) fica para uma etapa futura —
// este enum só identifica o papel da Pessoa no domínio.
enum PerfilPessoa {
  SECRETARIA
  GESTOR
  DIRETORA
  PROFESSOR
  AUXILIAR
}

// Um módulo novo no futuro é só um valor novo aqui — nunca um range de IDs de escola.
enum ModuloSistema {
  PDI
  MENSAGENS
  FORMULARIO_UM_TERCO
  CORRECOES
}

// --- Entidades ----------------------------------------------------------------------------

model Escola {
  id        Int            @id @default(autoincrement())
  nome      String         @db.VarChar(200)
  status    StatusRegistro @default(ATIVA)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)
  version   Int       @default(1) // preparado para concorrência otimista (ver README)

  modulos          EscolaModulo[]
  turmas           Turma[]
  vinculosEscolares VinculoEscolar[]
  aplicacoesPdi    AplicacaoPdi[]
  fichasPdi        FichaPdi[]
  anamneses        Anamnese[]
  conversasMensagem ConversaMensagem[]

  @@map("escolas")
}

// Relação genérica Escola↔Módulo — nunca uma coluna fixa por módulo (usaPdi/usaMensagens/...).
model EscolaModulo {
  id       Int           @id @default(autoincrement())
  escolaId Int
  escola   Escola        @relation(fields: [escolaId], references: [id], onDelete: Restrict)
  modulo   ModuloSistema
  ativo    Boolean       @default(true)

  @@unique([escolaId, modulo])
  @@map("escola_modulos")
}

// Lista fechada de disciplinas do PDI. Nenhuma regra de runtime pode assumir um ID fixo
// (ex.: "Inglês = 6") — só o nome importa para lógica de negócio.
model Disciplina {
  id   Int    @id @default(autoincrement())
  nome String @unique @db.VarChar(100)

  vinculosProfessor ProfessorTurmaDisciplina[]
  modelosPdi        ModeloPdi[]
  aplicacaoModelosPdi AplicacaoModeloPdi[]
  fichasPdi         FichaPdi[]

  @@map("disciplinas")
}

// Turma nunca é excluída fisicamente — só inativada. A identidade lógica (escola+ano
// letivo+série/segmento+turno+identificador) precisa ser única mesmo entre turmas inativas —
// ver identidadeChave abaixo e o comentário completo em src/domain/turma.ts.
model Turma {
  id       Int         @id @default(autoincrement())
  escolaId Int
  escola   Escola      @relation(fields: [escolaId], references: [id], onDelete: Restrict)

  anoLetivo Int
  etapa     EtapaEnsino

  // Fundamental
  anoSerie Int?

  // Educação Infantil
  segmento SegmentoInfantil?
  nivel    NivelInfantil?

  turno         Turno
  identificador Int

  nome   String         @db.VarChar(60)
  status StatusRegistro @default(ATIVA)

  // Chave técnica de unicidade (string não-nula, calculada em src/domain/turma.ts) — evita o
  // problema de NULL nunca ser igual a NULL num índice único direto sobre colunas que variam
  // por etapa (anoSerie só existe no Fundamental; segmento/nivel só na Educação Infantil).
  identidadeChave String @unique @db.VarChar(100)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)
  version   Int       @default(1)

  alunos             AlunoPdi[]
  vinculosProfessor  ProfessorTurmaDisciplina[]
  vinculosAuxiliar   AuxiliarTurma[]
  fichasPdi          FichaPdi[]
  anamneses          Anamnese[]

  // Cobre o filtro mais comum da listagem (GET /api/turmas?escolaId=...&anoLetivo=...&status=...)
  // — Postgres também usa o prefixo desse índice (só escolaId, ou escolaId+anoLetivo) sozinho.
  @@index([escolaId, anoLetivo, status])
  @@map("turmas")
}

// Entidade única para qualquer pessoa/profissional (Secretaria, Gestor/Supervisor, Diretora,
// Professor, Auxiliar), diferenciada por `perfil` — TPH em vez de 5 tabelas, ver README.md
// para o raciocínio completo (mesmo usado na tentativa anterior em C#/EF Core).
model Pessoa {
  id     Int          @id @default(autoincrement())
  nome   String       @db.VarChar(200)
  email  String       @unique @db.VarChar(200)
  cargo  String?      @db.VarChar(100)
  perfil PerfilPessoa
  status StatusPessoa @default(ATIVO)

  // Hash bcrypt da senha de login. Nulo = pessoa sem credencial (não consegue autenticar).
  // Nunca retornado por nenhuma rota — ver src/api/routes/auth.ts.
  senhaHash String? @db.VarChar(100)

  // true = senhaHash é uma senha temporária (gerada no cadastro ou em "gerar nova senha
  // temporária"), ainda não trocada pela pessoa. Bloqueia navegação normal no app (ver
  // bloquearSenhaTemporariaPendente em api/middleware/auth.ts) até /api/auth/trocar-senha.
  senhaTemporaria         Boolean   @default(false)
  senhaTemporariaExpiraEm DateTime?

  // Incrementado sempre que uma sessão anterior deve parar de funcionar imediatamente (troca de
  // senha, reset administrativo, inativação) — o JWT carrega a versão vigente no momento em que
  // foi emitido; requireAuth compara com o valor atual no banco a cada requisição (ver
  // api/middleware/auth.ts). Sem isso, um token antigo continuaria válido até expirar (12h).
  authVersion Int @default(1)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)
  version   Int       @default(1)

  vinculosEscolares      VinculoEscolar[]
  vinculosComoProfessor  ProfessorTurmaDisciplina[] @relation("ProfessorVinculo")
  vinculosComoAuxiliar   AuxiliarTurma[]            @relation("AuxiliarVinculo")
  eventos                PessoaEvento[]             @relation("PessoaEventoPessoa")
  fichasComoResponsavel  FichaPdi[]                 @relation("FichaProfessorResponsavel")
  participacoesConversa  ParticipanteConversa[]
  mensagensEnviadas      Mensagem[]                 @relation("MensagemRemetente")

  @@map("pessoas")
}

enum TipoEventoPessoa {
  CRIACAO
  VINCULO_CRIADO
  RESET_SENHA
  PRIMEIRO_ACESSO_CONCLUIDO
  INATIVACAO
  REATIVACAO
}

// Log de auditoria append-only (nunca sobrescrito) das ações sensíveis sobre uma Pessoa — mesmo
// padrão de histórico já usado em turmaProfessores/pdiFichaHistorico no frontend: cada evento é
// uma linha nova, nunca um campo único sobrescrito, para não perder o rastro de resets repetidos.
// Nunca guarda senha nem hash (ver CLAUDE.md/pedido de autenticação).
model PessoaEvento {
  id       Int              @id @default(autoincrement())
  pessoaId Int
  pessoa   Pessoa           @relation("PessoaEventoPessoa", fields: [pessoaId], references: [id], onDelete: Restrict)
  tipo     TipoEventoPessoa
  autorId  Int
  detalhe  String?          @db.VarChar(200)

  criadoEm DateTime @default(now())

  @@index([pessoaId, criadoEm])
  @@map("pessoa_eventos")
}

// Vínculo genérico Pessoa↔Escola (qualquer perfil). Nunca apagado fisicamente.
model VinculoEscolar {
  id        Int           @id @default(autoincrement())
  escolaId  Int
  escola    Escola        @relation(fields: [escolaId], references: [id], onDelete: Restrict)
  pessoaId  Int
  pessoa    Pessoa        @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  status    StatusVinculo @default(ATIVO)
  dataInicio DateTime     @db.Date
  dataFim    DateTime?    @db.Date

  createdAt DateTime @default(now())
  createdBy String?  @db.VarChar(200)

  @@index([escolaId, pessoaId, status])
  @@map("vinculos_escolares")
}

// Vínculo Professor↔Turma↔Disciplina. No máximo um vínculo ATIVO por (turmaId, disciplinaId) —
// GARANTIDO POR ÍNDICE ÚNICO PARCIAL no Postgres (WHERE status = 'ATIVO'), adicionado à mão na
// migration porque o Prisma ainda não tem sintaxe declarativa para índice parcial — ver
// prisma/migrations/.../migration.sql e README.md. O índice abaixo no schema é só o "normal"
// (não único) para consultas; a garantia de unicidade mora na migration SQL.
model ProfessorTurmaDisciplina {
  id           Int    @id @default(autoincrement())
  turmaId      Int
  turma        Turma  @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  professorId  Int
  professor    Pessoa @relation("ProfessorVinculo", fields: [professorId], references: [id], onDelete: Restrict)
  disciplinaId Int
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)

  status     StatusVinculo @default(ATIVO)
  dataInicio DateTime      @db.Date
  dataFim    DateTime?     @db.Date

  @@index([turmaId, disciplinaId])
  @@index([professorId])
  @@map("professor_turma_disciplinas")
}

// Vínculo Auxiliar↔Turma (nunca Auxiliar↔Aluno). No máximo um vínculo ATIVO por turma —
// mesma estratégia de índice único parcial da ProfessorTurmaDisciplina (ver migration.sql).
// Um mesmo Auxiliar em várias turmas ativas simultaneamente NÃO é restringido — decisão de
// negócio ainda pendente (ver README.md).
model AuxiliarTurma {
  id         Int    @id @default(autoincrement())
  turmaId    Int
  turma      Turma  @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  auxiliarId Int
  auxiliar   Pessoa @relation("AuxiliarVinculo", fields: [auxiliarId], references: [id], onDelete: Restrict)

  status     StatusVinculo @default(ATIVO)
  dataInicio DateTime      @db.Date
  dataFim    DateTime?     @db.Date

  @@index([turmaId])
  @@index([auxiliarId])
  @@map("auxiliar_turmas")
}

// Aluno PDI possui uma única turma regular atual. De propósito NÃO existe escolaId aqui — a
// escola atual é sempre derivada de turma.escolaId (ver README.md sobre a inconsistência
// equivalente já existente no mock do frontend, que aqui não pode acontecer).
model AlunoPdi {
  id      Int    @id @default(autoincrement())
  nome    String @db.VarChar(200)
  turmaId Int
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Restrict)

  // Adicionados na tarefa de Anamnese real: são dado cadastral do aluno (nunca mudam por conta
  // de uma nova versão de Anamnese), não pertenciam ao AlunoPdi real até aqui porque nenhuma
  // tela precisava deles — o mock já os tinha soltos no aluno. Ambos opcionais: alunos já
  // cadastrados não têm valor retroativo.
  dataNascimento                 DateTime? @db.Date
  responsavelNome                String    @db.VarChar(200)
  responsavelParentesco          String    @db.VarChar(50)
  responsavelTelefone            String    @db.VarChar(30)
  responsavelTelefoneSecundario  String?   @db.VarChar(30)

  status StatusAluno @default(ATIVO)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)
  version   Int       @default(1)

  fichasPdi  FichaPdi[]
  anamneses  Anamnese[]

  @@index([turmaId])
  @@map("alunos_pdi")
}

// Modelo PDI: define QUAIS perguntas existem para uma disciplina. No máximo um ATIVO por
// disciplina — GARANTIDO POR ÍNDICE ÚNICO PARCIAL no Postgres (WHERE status = 'ATIVA'), mesma
// estratégia de ProfessorTurmaDisciplina/AuxiliarTurma (ver migration.sql). Nunca apagado
// fisicamente: reativar/inativar preserva histórico. Disciplina nunca é alterada após a criação
// (a UI atual não oferece isso — ver GestaoPdi no frontend).
model ModeloPdi {
  id           Int            @id @default(autoincrement())
  nome         String         @db.VarChar(200)
  disciplinaId Int
  disciplina   Disciplina     @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)
  status       StatusRegistro @default(ATIVA)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)
  version   Int       @default(1)

  perguntas PerguntaPdi[]
  snapshots AplicacaoModeloPdi[]

  @@index([disciplinaId, status])
  @@map("modelos_pdi")
}

// Cada modelo carrega sua própria lista de perguntas — TODAS igualmente editáveis/reordenáveis/
// inativáveis, mesmo as que nascem com o modelo (`origem` é só informativo, nunca proteção — ver
// seção 16 do pedido). `opcoes` (seleção/marcação) e `complementar` (campo condicional extra,
// {gatilho, label}) usam Json por serem estruturas variáveis por pergunta — evita improvisar
// string concatenada e preserva a ordem das opções como veio.
enum OrigemPerguntaPdi {
  ESTRUTURADA
  HABILIDADE
  ORIENTACAO
  QUALITATIVA
  PERSONALIZADA
}

enum TipoRespostaPdi {
  TEXTO
  SELECAO
  MARCACAO
  NUMERO
  ORIENTACAO
}

model PerguntaPdi {
  id       Int       @id @default(autoincrement())
  modeloId Int
  modelo   ModeloPdi @relation(fields: [modeloId], references: [id], onDelete: Restrict)

  secao        String            @db.VarChar(100)
  subsecao     String?           @db.VarChar(100)
  codigo       String?           @db.VarChar(20)
  texto        String            @db.Text
  indicador    String?           @db.VarChar(100)
  origem       OrigemPerguntaPdi
  tipoResposta TipoRespostaPdi
  opcoes       Json?
  complementar Json?
  ordem        Int
  status       StatusRegistro    @default(ATIVA)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)
  version   Int       @default(1)

  snapshots AplicacaoPerguntaPdi[]

  @@index([modeloId, ordem])
  @@map("perguntas_pdi")
}

// Template GLOBAL de perguntas padrão — fonte usada (opcionalmente) ao criar um ModeloPdi novo,
// em qualquer disciplina (nunca específico de uma). Editável livremente pela Secretaria (CRUD
// completo, incluindo hard delete: diferente de PerguntaPdi, nada no sistema referencia esta
// tabela por FK — ela só é LIDA e COPIADA para dentro do ModeloPdi no momento da criação, nunca
// mais depois — então não existe snapshot/histórico a proteger aqui).
model PerguntaPdiPadrao {
  id           Int               @id @default(autoincrement())
  secao        String            @db.VarChar(100)
  subsecao     String?           @db.VarChar(100)
  codigo       String?           @db.VarChar(20)
  texto        String            @db.Text
  indicador    String?           @db.VarChar(100)
  origem       OrigemPerguntaPdi
  tipoResposta TipoRespostaPdi
  opcoes       Json?
  complementar Json?
  ordem        Int
  status       StatusRegistro    @default(ATIVA)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)

  @@index([ordem])
  @@map("perguntas_pdi_padrao")
}

// Aplicação PDI pertence a UMA escola (nunca a uma disciplina) — define o período em que os
// professores preenchem os formulários. Sem `status` de propósito: não existe cancelamento/
// exclusão administrativa nesta etapa (o mock também nunca teve status explícito — vigência é
// sempre derivada de dataInicio/dataFim, ver domain/pdiAplicacoes.ts). `nome` é opcional — a UI
// atual nunca pediu isso à Secretaria, quem identifica a aplicação é escola+período.
model AplicacaoPdi {
  id         Int      @id @default(autoincrement())
  escolaId   Int
  escola     Escola   @relation(fields: [escolaId], references: [id], onDelete: Restrict)
  nome       String?  @db.VarChar(200)
  dataInicio DateTime @db.Date
  dataFim    DateTime @db.Date

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)
  version   Int       @default(1)

  modelos     AplicacaoModeloPdi[]
  reaberturas ReaberturaPdi[]
  fichas      FichaPdi[]

  @@index([escolaId, dataInicio, dataFim])
  @@map("aplicacoes_pdi")
}

// Snapshot IMUTÁVEL de um ModeloPdi ativo no momento da criação da Aplicação — nunca mais lido
// nem atualizado a partir do ModeloPdi vivo depois disso (ver seção 3/4/9 do pedido). Mantém FK
// pro modelo/disciplina originais só para rastreabilidade (nenhum dos dois é hard-deletado no
// sistema, então a FK nunca fica órfã) — quem importa pra exibição histórica é sempre
// `nome`/`disciplinaNome`, capturados aqui, nunca uma nova consulta ao registro vivo.
model AplicacaoModeloPdi {
  id          Int          @id @default(autoincrement())
  aplicacaoId Int
  aplicacao   AplicacaoPdi @relation(fields: [aplicacaoId], references: [id], onDelete: Restrict)

  modeloIdOriginal Int
  modeloOriginal   ModeloPdi @relation(fields: [modeloIdOriginal], references: [id], onDelete: Restrict)
  nome             String    @db.VarChar(200)

  disciplinaId   Int
  disciplina     Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)
  disciplinaNome String     @db.VarChar(100)

  perguntas AplicacaoPerguntaPdi[]
  fichas    FichaPdi[]

  @@index([aplicacaoId])
  @@map("aplicacao_modelos_pdi")
}

// Snapshot IMUTÁVEL de cada PerguntaPdi ATIVA do modelo no momento da criação — mesmos campos do
// PerguntaPdi vivo, copiados (nunca referenciados por FK como fonte de leitura futura).
model AplicacaoPerguntaPdi {
  id                Int                @id @default(autoincrement())
  aplicacaoModeloId Int
  aplicacaoModelo   AplicacaoModeloPdi @relation(fields: [aplicacaoModeloId], references: [id], onDelete: Restrict)

  perguntaIdOriginal Int
  perguntaOriginal   PerguntaPdi @relation(fields: [perguntaIdOriginal], references: [id], onDelete: Restrict)

  secao        String            @db.VarChar(100)
  subsecao     String?           @db.VarChar(100)
  codigo       String?           @db.VarChar(20)
  texto        String            @db.Text
  indicador    String?           @db.VarChar(100)
  origem       OrigemPerguntaPdi
  tipoResposta TipoRespostaPdi
  opcoes       Json?
  complementar Json?
  ordem        Int

  respostas RespostaPdi[]

  @@index([aplicacaoModeloId])
  @@map("aplicacao_perguntas_pdi")
}

// Reabertura real e histórica de uma Aplicação já encerrada — NUNCA edita dataInicio/dataFim
// originais da Aplicação (ver seção 19 do pedido: a vigência original continua exibida como
// estava). Só a Secretaria cria (ver rota); `solicitadoPorTipo` é só um registro informativo de
// quem pediu por fora do sistema — reaproveita PerfilPessoa em vez de inventar outro enum igual.
model ReaberturaPdi {
  id          Int          @id @default(autoincrement())
  aplicacaoId Int
  aplicacao   AplicacaoPdi @relation(fields: [aplicacaoId], references: [id], onDelete: Restrict)

  dataInicio        DateTime     @db.Date
  dataFim           DateTime     @db.Date
  solicitadoPorTipo PerfilPessoa
  motivo            String?      @db.VarChar(500)

  createdAt DateTime @default(now())
  createdBy String?  @db.VarChar(200)

  @@index([aplicacaoId])
  @@map("reaberturas_pdi")
}

enum StatusFichaPdi {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

// Ficha PDI concreta: Aplicação + Aluno + Disciplina — identidade única, nunca duplicada (índice
// único abaixo). Criada SOB DEMANDA na primeira abertura real (nunca em lote na criação da
// Aplicação — ver domain/pdiFichas.ts e api/routes/pdiFichas.ts). As perguntas NUNCA são copiadas
// para cá: vêm sempre de `AplicacaoModeloPdi`/`AplicacaoPerguntaPdi` (o conteúdo já está
// congelado lá). O que ESTA entidade congela é o CONTEXTO OPERACIONAL do aluno/professor no
// momento em que a ficha nasceu — algo que o snapshot da Aplicação não cobre, porque Aluno/Turma/
// Escola/ProfessorTurmaDisciplina são todos vivos e podem mudar depois (ex.: aluno muda de turma,
// professor é substituído — a ficha antiga continua mostrando o contexto de quando nasceu).
// Mantém FKs reais para Turma/Escola/Disciplina/Professor (nenhum é hard-deletado) só para
// rastreabilidade; quem importa pra exibição histórica são sempre os campos `*Snapshot`.
model FichaPdi {
  id Int @id @default(autoincrement())

  aplicacaoId       Int
  aplicacao         AplicacaoPdi       @relation(fields: [aplicacaoId], references: [id], onDelete: Restrict)
  aplicacaoModeloId Int
  aplicacaoModelo   AplicacaoModeloPdi @relation(fields: [aplicacaoModeloId], references: [id], onDelete: Restrict)
  alunoId           Int
  aluno             AlunoPdi           @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  disciplinaId      Int
  disciplina        Disciplina         @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)

  // Professor RESPONSÁVEL pela turma+disciplina no momento da criação — um fato pedagógico,
  // resolvido via ProfessorTurmaDisciplina ATIVO. Nunca confundir com quem executou a ação
  // (createdBy/updatedBy abaixo): um Gestor pode criar/preencher a ficha de um Professor.
  professorResponsavelId Int
  professorResponsavel   Pessoa @relation("FichaProfessorResponsavel", fields: [professorResponsavelId], references: [id], onDelete: Restrict)

  // --- Contexto histórico congelado na criação — NUNCA recalculado depois (ver seção 6/7/8 do
  // pedido de Fichas PDI). Turma/Escola mantêm FK real (traceability), mas o nome exibido é
  // sempre o *Snapshot, mesmo que o nome atual da turma/escola/professor tenha mudado desde então.
  alunoNomeSnapshot           String   @db.VarChar(200)
  turmaId                     Int
  turma                       Turma    @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  turmaNomeSnapshot           String   @db.VarChar(60)
  escolaId                    Int
  escola                      Escola   @relation(fields: [escolaId], references: [id], onDelete: Restrict)
  escolaNomeSnapshot          String   @db.VarChar(200)
  disciplinaNomeSnapshot      String   @db.VarChar(100)
  professorNomeSnapshot       String   @db.VarChar(200)
  aplicacaoDataInicioSnapshot DateTime @db.Date
  aplicacaoDataFimSnapshot    DateTime @db.Date

  // Status muda só por ação explícita (ver domain/pdiFichas.ts): nenhuma resposta = PENDENTE;
  // alguma resposta salva = EM_ANDAMENTO; ação explícita de concluir = CONCLUIDA. Nunca volta
  // atrás sozinho (editar respostas depois de concluída não reverte o status).
  status StatusFichaPdi @default(PENDENTE)

  createdAt    DateTime  @default(now())
  createdBy    String?   @db.VarChar(200)
  updatedAt    DateTime? @updatedAt
  updatedBy    String?   @db.VarChar(200)
  concluidaEm  DateTime?
  concluidaPor String?   @db.VarChar(200)
  version      Int       @default(1)

  respostas RespostaPdi[]

  @@unique([aplicacaoId, alunoId, disciplinaId])
  @@index([alunoId])
  @@index([professorResponsavelId])
  @@map("fichas_pdi")
}

// Resposta de UMA pergunta de UMA Ficha — no máximo uma por (fichaId, aplicacaoPerguntaId), ver
// índice único abaixo. `valor` é Json de propósito (nunca uma coluna por tipo de pergunta):
// formato depende de `aplicacaoPergunta.tipoResposta` — {resposta, complementarTexto?} cobre
// texto/número/seleção/marcação igual ao mock. Perguntas informativas (tipoResposta ORIENTACAO)
// nunca geram linha aqui. Diferente de FichaPdi, respostas SÃO mutáveis livremente enquanto a
// Ficha estiver editável — não há contexto histórico para congelar numa resposta em si.
model RespostaPdi {
  id                  Int                  @id @default(autoincrement())
  fichaId             Int
  ficha               FichaPdi             @relation(fields: [fichaId], references: [id], onDelete: Restrict)
  aplicacaoPerguntaId Int
  aplicacaoPergunta   AplicacaoPerguntaPdi @relation(fields: [aplicacaoPerguntaId], references: [id], onDelete: Restrict)

  valor Json

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)

  @@unique([fichaId, aplicacaoPerguntaId])
  @@index([fichaId])
  @@map("respostas_pdi")
}

// --- Anamnese -------------------------------------------------------------------------------
// Entidades PRÓPRIAS, deliberadamente separadas de ModeloPdi/PerguntaPdi/FichaPdi/RespostaPdi —
// Anamnese e PDI por disciplina têm ciclos de vida diferentes (uma Anamnese é do aluno inteiro,
// versionada ao longo do tempo; não tem vigência/Aplicação/Reabertura). Ver domain/anamnese.ts.

enum TipoRespostaAnamnese {
  TEXTO
  SELECAO
  MARCACAO
  NUMERO
  ORIENTACAO
  SELECAO_MULTIPLA
}

enum StatusAnamnese {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum PossuiLaudo {
  SIM
  NAO
  EM_INVESTIGACAO
}

// Corpo CONFIGURÁVEL da Anamnese (aspectos comportamentais/psicomotores/cognitivos, comunicação,
// escrita, leitura) — só a Secretaria administra. No máximo UM ATIVO por vez (índice único
// parcial no Postgres sobre a própria coluna `status`, ver migration.sql — como não há dimensão
// de partição aqui, diferente de ModeloPdi/disciplina, todas as linhas que satisfazem o filtro
// têm o mesmo valor 'ATIVA', então a unicidade da coluna já garante no máximo uma linha).
// Versão só é criada quando a versão ATUAL já tem alguma Anamnese vinculada (seção 5/6 do
// pedido) — editar uma versão ainda não usada por ninguém é uma alteração in-place, sem gerar
// versão nova (mesma lógica de ModeloPdi/PerguntaPdi nunca terem sido usados ainda).
model ModeloAnamnese {
  id     Int            @id @default(autoincrement())
  nome   String         @db.VarChar(200)
  versao Int
  status StatusRegistro @default(ATIVA)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)

  perguntas  PerguntaAnamnese[]
  anamneses  Anamnese[]

  @@map("modelos_anamnese")
}

// Mesma filosofia de PerguntaPdi (seção/subseção/tipo/opções/ordem/status), com um tipo a mais
// (SELECAO_MULTIPLA, seção 8/24 do pedido) e um campo a mais (`explicacao`, o texto de tooltip
// que várias perguntas de aspecto psicomotor/cognitivo têm no formulário original — preservado
// fielmente, nunca reescrito). `complementar` segue o mesmo formato {gatilho, label} de
// PerguntaPdi; para a observação SEMPRE disponível dos aspectos (não condicional a uma resposta
// específica, diferente do PDI), o gatilho usa o valor especial `"sempre"` — ver domain/anamnese.ts.
model PerguntaAnamnese {
  id               Int            @id @default(autoincrement())
  modeloAnamneseId Int
  modeloAnamnese   ModeloAnamnese @relation(fields: [modeloAnamneseId], references: [id], onDelete: Restrict)

  secao        String               @db.VarChar(100)
  subsecao     String?              @db.VarChar(100)
  texto        String               @db.Text
  explicacao   String?              @db.Text
  tipoResposta TipoRespostaAnamnese
  opcoes       Json?
  complementar Json?
  ordem        Int
  status       StatusRegistro       @default(ATIVA)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)

  respostas RespostaAnamnese[]

  @@index([modeloAnamneseId, ordem])
  @@map("perguntas_anamnese")
}

// Uma versão preenchida da Anamnese de UM aluno. Várias por aluno ao longo do tempo (histórico
// imutável); a ATUAL é sempre a de maior `numeroVersao` — não existe flag separada, pra não abrir
// espaço pra dessincronia. `modeloAnamneseId` aponta pra versão do Modelo em uso NAQUELE
// MOMENTO — como ModeloAnamnese/PerguntaAnamnese já usados nunca são editados in-place (seção 5),
// isso sozinho já garante histórico resistente a mudanças futuras do Modelo, sem precisar
// duplicar fisicamente as perguntas pra cada Anamnese (seção 21 do pedido).
model Anamnese {
  id               Int            @id @default(autoincrement())
  alunoId          Int
  aluno            AlunoPdi       @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  modeloAnamneseId Int
  modeloAnamnese   ModeloAnamnese @relation(fields: [modeloAnamneseId], references: [id], onDelete: Restrict)
  numeroVersao     Int

  status StatusAnamnese @default(PENDENTE)

  // --- Parte estrutural/fixa (seções 1/3/4/29/30/31 do pedido) — nunca vira PerguntaAnamnese.
  anoEscolaridade String?      @db.VarChar(50)
  possuiLaudo     PossuiLaudo?
  cid             String?      @db.VarChar(50)

  responsaveisPdi Json // [{ cargo, nome }]

  acompanhadoForaDaEscola      Boolean?
  especialidadesAcompanhamento Json? // string[] (chaves de ESPECIALIDADES_ACOMPANHAMENTO)
  especialidadeOutroTexto      String? @db.VarChar(200)

  usoContinuoMedicamento      Boolean?
  medicamentoQual             String?  @db.VarChar(200)
  medicamentoPrescritoPor     String?  @db.VarChar(200)
  medicamentoQuando           String?  @db.VarChar(200)
  medicamentoParaQue          String?  @db.VarChar(200)
  medicamentoEfeitosColaterais Boolean?
  medicamentoEfeitosQuais     String?  @db.Text

  comoGostaDeSeDivertir String? @db.Text
  idadeInicioEscola     String? @db.VarChar(50)
  ondeComecou           String? @db.VarChar(200)
  percursoEscolar       String? @db.Text
  frequentaSalaRecursos Boolean?
  frequenciaAtendimento String? @db.VarChar(200)

  // Contexto histórico congelado na criação desta VERSÃO — mesmo raciocínio de FichaPdi.
  // Snapshot, nunca fonte de autorização (seção 28 do pedido).
  alunoNomeSnapshot  String @db.VarChar(200)
  turmaId            Int
  turma              Turma  @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  turmaNomeSnapshot  String @db.VarChar(60)
  escolaId           Int
  escola             Escola @relation(fields: [escolaId], references: [id], onDelete: Restrict)
  escolaNomeSnapshot String @db.VarChar(200)

  createdAt    DateTime  @default(now())
  createdBy    String?   @db.VarChar(200)
  updatedAt    DateTime? @updatedAt
  updatedBy    String?   @db.VarChar(200)
  concluidaEm  DateTime?
  concluidaPor String?   @db.VarChar(200)

  respostas RespostaAnamnese[]

  @@unique([alunoId, numeroVersao])
  @@index([alunoId])
  @@map("anamneses")
}

// Resposta de UMA pergunta configurável de UMA Anamnese — no máximo uma por (anamneseId,
// perguntaAnamneseId). `valor` é Json (nunca coluna por tipo): {resposta, complementarTexto?}
// para TEXTO/SELECAO/MARCACAO/NUMERO, {respostas: string[], complementarTexto?} para
// SELECAO_MULTIPLA (seção 24 do pedido — nunca string separada por vírgula). Perguntas
// ORIENTACAO nunca geram linha aqui.
model RespostaAnamnese {
  id                 Int              @id @default(autoincrement())
  anamneseId         Int
  anamnese           Anamnese         @relation(fields: [anamneseId], references: [id], onDelete: Restrict)
  perguntaAnamneseId Int
  perguntaAnamnese   PerguntaAnamnese @relation(fields: [perguntaAnamneseId], references: [id], onDelete: Restrict)

  valor Json

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(200)

  @@unique([anamneseId, perguntaAnamneseId])
  @@index([anamneseId])
  @@map("respostas_anamnese")
}

// --- Mensagens --------------------------------------------------------------------------------
// Comunicação interna entre perfis, restrita pela hierarquia (Secretaria↔Diretora; Diretora↔
// Gestor/Professor/Auxiliar da mesma escola; Gestor↔Professor/Auxiliar da mesma escola — ver
// domain/mensagens.ts para a matriz completa). Toda Conversa é SEMPRE privada entre exatamente 2
// Pessoas, mesmo quando nasce de um envio em massa: um envio pra 20 Professores cria 20
// ConversaMensagem independentes (uma por destinatário), nunca uma conversa com 21 participantes
// — `loteId` só agrupa pra quem enviou saber que vieram da mesma ação, nunca vira grupo.

// Conversa/thread — sempre amarrada a UMA escola de contexto (mesmo Secretaria↔Diretora, que usa
// a escola do vínculo da Diretora). Nunca apagada fisicamente.
model ConversaMensagem {
  id       Int    @id @default(autoincrement())
  escolaId Int
  escola   Escola @relation(fields: [escolaId], references: [id], onDelete: Restrict)
  assunto  String @db.VarChar(200)

  // Agrupa as N conversas nascidas do mesmo envio em massa (só informativo pro remetente ver
  // "enviei pra 20 pessoas" e calcular "7 de 20 leram" — nunca concede acesso cruzado entre elas).
  loteId String? @db.VarChar(40)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(200)
  // Atualizado a cada Mensagem nova (inclusive respostas) — usado só pra ordenar "mais recentes
  // primeiro" na caixa de entrada, nunca como fonte de autorização.
  updatedAt DateTime? @updatedAt

  participantes ParticipanteConversa[]
  mensagens     Mensagem[]

  @@index([escolaId])
  @@index([loteId])
  @@map("conversas_mensagem")
}

// Sempre exatamente 2 linhas por Conversa — nunca grupo. Guarda só o estado de ocultação
// individual ("Excluir para mim" = seção 15 do pedido). NUNCA é fonte de autorização por si só:
// quem pode acessar/responder uma Conversa é recalculado a cada requisição a partir do
// VinculoEscolar/perfil ATUAIS dos dois lados (ver exigirAcessoConversa em mensagens.ts) — a
// mesma filosofia já usada em Ficha PDI (relação histórica nunca concede acesso).
model ParticipanteConversa {
  id         Int              @id @default(autoincrement())
  conversaId Int
  conversa   ConversaMensagem @relation(fields: [conversaId], references: [id], onDelete: Restrict)
  pessoaId   Int
  pessoa     Pessoa           @relation(fields: [pessoaId], references: [id], onDelete: Restrict)

  // null = visível. "Excluir para mim" preenche; uma Mensagem nova nessa Conversa limpa de volta
  // pra null automaticamente pro destinatário (seção 45 do pedido: atividade nova faz reaparecer).
  ocultaEm DateTime?

  createdAt DateTime @default(now())

  @@unique([conversaId, pessoaId])
  @@index([pessoaId])
  @@map("participantes_conversa")
}

// Uma mensagem dentro de uma thread. `lidaEm` fica aqui mesmo (não numa tabela separada por
// destinatário) porque toda Conversa tem exatamente 2 participantes — o destinatário de qualquer
// Mensagem é sempre, sem ambiguidade, "o outro participante" (quem não é o remetente). Nunca
// editada depois de criada (seção 27 do pedido); nunca apagada fisicamente.
model Mensagem {
  id          Int              @id @default(autoincrement())
  conversaId  Int
  conversa    ConversaMensagem @relation(fields: [conversaId], references: [id], onDelete: Restrict)
  remetenteId Int
  remetente   Pessoa           @relation("MensagemRemetente", fields: [remetenteId], references: [id], onDelete: Restrict)

  conteudo String @db.Text

  // Preenchido quando o OUTRO participante (nunca o próprio remetente) lê esta mensagem.
  lidaEm DateTime?

  createdAt DateTime @default(now())

  @@index([conversaId, createdAt])
  @@map("mensagens")
}
